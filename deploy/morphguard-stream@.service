# Stream processor for one log source: systemctl enable --now morphguard-stream@hdfs
# deploy/vm_deploy.sh (WITH_STREAM=1) installs it with __USER__ and __BACKEND__
# filled in (in a system unit %u/%h would be root's). Kafka must be up first.
[Unit]
Description=MorphGuard stream processor (%i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__BACKEND__
ExecStart=__BACKEND__/venv/bin/python -m streaming.processor --source %i
Restart=on-failure
RestartSec=10
# Kafka + API + processor fit in 8 GB; cap the processor so it can't starve the API.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
